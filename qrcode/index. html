<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Quick QR Code Generator</title>

  <!-- QRCode.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #f5f5f5;

      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 480px;
      background: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    h1 {
      margin: 0;
      text-align: center;
      font-size: 28px;
    }

    .subtitle {
      text-align: center;
      color: #777;
      margin: 8px 0 25px;
    }

    textarea {
      width: 100%;
      height: 110px;
      padding: 15px;
      border: 2px solid #ddd;
      border-radius: 12px;
      resize: none;
      font-size: 16px;
      outline: none;
    }

    textarea:focus {
      border-color: #111;
    }

    .qr-container {
      margin-top: 25px;
      display: flex;
      justify-content: center;
    }

    #qrcode {
      background: white;
      padding: 15px;
      border-radius: 12px;
    }

    #qrcode img,
    #qrcode canvas {
      display: block;
      max-width: 100%;
    }

    .buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 25px;
    }

    button {
      border: none;
      padding: 14px;
      border-radius: 10px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
    }

    .generate {
      background: #111;
      color: white;
    }

    .download {
      background: #e9e9e9;
      color: #111;
    }

    button:hover {
      transform: translateY(-2px);
    }

    .status {
      text-align: center;
      margin-top: 15px;
      font-size: 13px;
      color: #888;
      min-height: 18px;
    }

    @media (max-width: 500px) {
      .container {
        padding: 22px;
      }

      .buttons {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <h1>QR Code Generator</h1>

  <div class="subtitle">
    สร้าง QR Code ได้ทันที
  </div>

  <textarea
    id="text"
    placeholder="กรอก URL หรือข้อความ เช่น https://google.com"
  ></textarea>

  <div class="qr-container">
    <div id="qrcode"></div>
  </div>

  <div class="buttons">

    <button class="generate" onclick="generateQR()">
      สร้าง QR Code
    </button>

    <button class="download" onclick="downloadQR()">
      ดาวน์โหลด PNG
    </button>

  </div>

  <div class="status" id="status">
    กรอกข้อความเพื่อเริ่มสร้าง QR Code
  </div>

</div>


<script>

  const textInput = document.getElementById("text");
  const qrContainer = document.getElementById("qrcode");
  const statusText = document.getElementById("status");

  let qrTimer;


  // =========================
  // Generate QR
  // =========================

  function generateQR() {

    const text = textInput.value.trim();

    qrContainer.innerHTML = "";

    if (!text) {

      statusText.textContent =
        "กรุณากรอกข้อความหรือ URL";

      return;
    }

    new QRCode(qrContainer, {

      text: text,

      width: 260,
      height: 260,

      colorDark: "#000000",
      colorLight: "#ffffff",

      correctLevel: QRCode.CorrectLevel.H

    });

    statusText.textContent =
      "QR Code พร้อมใช้งาน";

  }


  // =========================
  // Real-time QR
  // =========================

  textInput.addEventListener("input", function() {

    clearTimeout(qrTimer);

    qrTimer = setTimeout(function() {

      generateQR();

    }, 300);

  });


  // =========================
  // Download QR
  // =========================

  function downloadQR() {

    const canvas =
      qrContainer.querySelector("canvas");

    const img =
      qrContainer.querySelector("img");

    if (!canvas && !img) {

      alert("กรุณาสร้าง QR Code ก่อน");

      return;

    }


    const link =
      document.createElement("a");


    // QRCode.js ส่วนใหญ่สร้าง canvas

    if (canvas) {

      link.href =
        canvas.toDataURL("image/png");

    }

    else {

      link.href = img.src;

    }


    link.download =
      "qrcode.png";


    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

  }

</script>

</body>
</html>